rules_version = '2';

// Doe + Vida — Cloud Firestore Security Rules
// Testes: tests/firestore.rules.test.ts (npm run test:rules). Toda mudança aqui vem com teste.
//
// LIBERADO:
//   users/{uid}  perfil (Tabela 1 da monografia) — somente o próprio usuário lê/cria/atualiza.
// AINDA NEGADO (próximas etapas, com testes):
//   users/{uid}/triagens/{id}       só resultado/motivos/datas; NUNCA respostas brutas (LGPD)
//   users/{uid}/agendamentos/{id}   planejamento pessoal (decisão C1)
//
// PROIBIDO: "allow read, write: if true;" e regras baseadas em data de expiração.
service cloud.firestore {
  match /databases/{database}/documents {

    function dono(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function perfilValido(d) {
      let campos = ['nome', 'email', 'dataNascimento', 'telefone', 'dataCadastro', 'consentimentoLgpdEm'];
      return d.keys().hasOnly(campos) && d.keys().hasAll(campos)
        && d.nome is string && d.nome.size() >= 2 && d.nome.size() <= 100
        && d.email is string && d.email == request.auth.token.email
        && d.dataNascimento is string && d.dataNascimento.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (d.telefone == null || (d.telefone is string && d.telefone.matches('^[0-9]{10,11}$')))
        && d.dataCadastro is timestamp
        && d.consentimentoLgpdEm is timestamp;
    }

    match /users/{uid} {
      allow read: if dono(uid);
      allow create: if dono(uid)
        && perfilValido(request.resource.data)
        && request.resource.data.dataCadastro == request.time
        && request.resource.data.consentimentoLgpdEm == request.time;
      allow update: if dono(uid)
        && perfilValido(request.resource.data)
        && request.resource.data.dataCadastro == resource.data.dataCadastro
        && request.resource.data.consentimentoLgpdEm == resource.data.consentimentoLgpdEm;
      // Exclusão de conta/dados (LGPD) será implementada em etapa própria.
      allow delete: if false;
    }

    // Todo o resto continua negado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
