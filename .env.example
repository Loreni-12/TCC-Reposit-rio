# Copie para .env.local e preencha com a configuração web do Firebase:
#   firebase apps:sdkconfig WEB --project doe-mais-vida
# A configuração web NÃO é segredo (a proteção vem das Security Rules),
# mas fica fora do Git por organização. Chaves de service account NUNCA entram aqui.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# false (padrão) = `npm run dev` usa o projeto real.
# true = usa os emuladores locais (Auth e Firestore); exige `npm run emulators` rodando
# em outro terminal, senão o login falha com "sem conexão".
VITE_USE_EMULATORS=false
