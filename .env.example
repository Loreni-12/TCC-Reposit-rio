# Copie para .env.local e preencha com a configuração web do Firebase:
#   firebase apps:sdkconfig WEB --project doe-mais-vida
# A configuração web NÃO é segredo (a proteção vem das Security Rules),
# mas fica fora do Git por organização. Chaves de service account NUNCA entram aqui.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true = em `npm run dev`, conecta aos emuladores locais (Auth e Firestore)
# em vez do projeto real. Rode `npm run emulators` em outro terminal.
VITE_USE_EMULATORS=true
